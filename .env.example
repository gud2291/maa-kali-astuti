# Core
# Full URL of the app (http://localhost:3000 for local dev)
APP_URL=http://localhost:3000
# 32+ char random string: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Database
# Turso libSQL database URL (libsql://mka-dev-<org>.turso.io)
TURSO_DATABASE_URL=
# Turso database auth token (read-write)
TURSO_AUTH_TOKEN=

# Seed
# Email of the first owner account (used by pnpm db:seed)
SEED_OWNER_EMAIL=
# Display name of the first owner (used by pnpm db:seed)
SEED_OWNER_NAME=

# Cloudflare
# Cloudflare account ID (dash.cloudflare.com → overview)
CF_ACCOUNT_ID=
# R2 API token — Access Key ID
R2_ACCESS_KEY_ID=
# R2 API token — Secret Access Key
R2_SECRET_ACCESS_KEY=
# R2 public bucket name (e.g. mka-media)
R2_BUCKET_PUBLIC=
# R2 private bucket name (e.g. mka-private)
R2_BUCKET_PRIVATE=
# Public URL of the R2 public bucket (e.g. https://pub-xxx.r2.dev or https://media.sadhakpawanpandey.com)
NEXT_PUBLIC_MEDIA_URL=
# Turnstile widget site key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Turnstile secret key
TURNSTILE_SECRET_KEY=
# Cloudflare Browser Rendering API token (for Kundali PDF)
CF_BROWSER_TOKEN=

# Email
# Resend API key (resend.com → API Keys)
RESEND_API_KEY=
# Sender address (e.g. Maa Kali Astuti <care@sadhakpawanpandey.com>)
EMAIL_FROM=
# Reply-to address (optional, e.g. care@sadhakpawanpandey.com)
EMAIL_REPLY_TO=

# Payments
# Razorpay Key ID (dashboard.razorpay.com → Settings → API Keys)
RAZORPAY_KEY_ID=
# Razorpay Key Secret
RAZORPAY_KEY_SECRET=
# Razorpay webhook secret (Settings → Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# Cron
# Secret for cron endpoint auth (random string, same in Vercel env + cron-job.org header)
CRON_SECRET=
